# Alibaba Cloud DashScope OpenAI-compatible endpoint; swap in another model if needed
VISION_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VISION_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
VISION_MODEL=qwen3.8-flash

# Disable reasoning for a big speedup (14s -> 3s in testing); set to true or remove this line if unsupported
VISION_ENABLE_THINKING=false
# Force JSON output; set to false if your gateway does not support response_format
VISION_JSON_MODE=true

# Optional: max PDF pages, max image side in pixels, max output tokens, request timeout in seconds
MAX_PDF_PAGES=10
MAX_IMAGE_SIDE=2000
MAX_OUTPUT_TOKENS=8192
VISION_TIMEOUT=300

# Concurrent extraction tasks (1-8); lower it if the gateway rate-limits you
BATCH_CONCURRENCY=3
